@app.route("/v1/messages", methods=["POST", "OPTIONS"])
def messages():
    if request.method == "OPTIONS":
        r = jsonify({})
        r.headers["Access-Control-Allow-Origin"] = "*"
        r.headers["Access-Control-Allow-Headers"] = "Content-Type, Authorization, x-api-key"
        r.headers["Access-Control-Allow-Methods"] = "POST, OPTIONS"
        return r, 200
    data = request.get_json(silent=True) or {}
    msgs = data.get("messages", [])
    user_message = ""
    for msg in reversed(msgs):
        if msg.get("role") == "user":
            user_message = msg.get("content", "")
            break
    result = ai_brain(user_message)
    r = jsonify({"content": [{"type": "text", "text": result}]})
    r.headers["Access-Control-Allow-Origin"] = "*"
    return r, 200

@app.route("/chat", methods=["POST"])
def chat():
    token = request.headers.get("Authorization")
    if token != MY_TOKEN:
        return jsonify({"error": "Invalid token"}), 401
    data = request.get_json()
    message = data.get("message", "")
    return jsonify({"response": ai_brain(message)})

