def detect_topics(m):
    """Return ordered list of matched topic keys from a message, deduped."""
    found = []
    for topic, keywords in TOPIC_KEYWORDS.items():
        for kw in keywords:
            if kw in m:
                if topic not in found:
                    found.append(topic)
                break
    return found

# ══════════════════════════════════════════════════════════
# STUDIO PASTE FORMATTER
# Wraps multiple scripts into a single copyable block with
# clear section dividers so devs know exactly where each
# script goes in the Explorer.
# ══════════════════════════════════════════════════════════
def studio_paste_block(scripts):
    """
    scripts = list of dicts:
      { "title": str, "name": str, "type": str, "location": str, "code": str }
    Returns a single formatted string ready to paste into Studio.
    """
    divider = "-- " + "═" * 60
    parts = []
    toc_lines = ["-- 📋 SCRIPTS IN THIS PASTE:"]
    for i, s in enumerate(scripts, 1):
        toc_lines.append(f"--   {i}. {s['name']} ({s['type']}) → {s['location']}")
    toc_lines.append("-- " + "═" * 60)

    parts.append("\n".join(toc_lines))

    for s in scripts:
        header = (
            f"{divider}\n"
            f"-- [{s['type'].upper()}]  {s['name']}\n"
            f"-- 📁 Location : {s['location']}\n"
            f"-- 📌 How      : {s['how']}\n"
            f"{divider}\n"
        )
        parts.append(header + s["code"])

    return "```lua\n" + "\n\n\n".join(parts) + "\n```"


