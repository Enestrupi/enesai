# FORMAT SCRIPT BLOCK WITH HEADER + PLACEMENT

# ══════════════════════════════════════════════════════════

def script_block(code, topic, script_type=None):
pl = detect_placement(code)
if script_type:
pl[“type”] = script_type
name = smart_name(topic, pl[“type”])
header = (
f”– ═══════════════════════════════════════════════\n”
f”– Script Name: {name}\n”
f”– Type:        {pl[‘type’]}\n”
f”– Location:    {pl[‘location’]}\n”
f”– ═══════════════════════════════════════════════\n”
)
full = header + code
placement = (
f”\n📍 **Placement**\n”
f”• Name: `{name}`\n”
f”• Type: **{pl[‘type’]}**\n”
f”• Location: `{pl['location']}`\n”
f”• Why: {pl[‘why’]}\n”
f”• How: {pl[‘how’]}\n”
)
return f”`lua\n{full}\n`{placement}”

