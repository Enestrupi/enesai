def gen_gun_client():
    code = (
        "local Players = game:GetService('Players')\n"
        "local UserInputService = game:GetService('UserInputService')\n"
        "local ReplicatedStorage = game:GetService('ReplicatedStorage')\n\n"
        "local player = Players.LocalPlayer\n"
        "local mouse = player:GetMouse()\n"
        "local camera = workspace.CurrentCamera\n"
        "local ShootRemote = ReplicatedStorage:WaitForChild('Remotes'):WaitForChild('Shoot')\n\n"
        "local CONFIG = { FIRE_RATE=0.1, AMMO=30, RELOAD_TIME=2.0 }\n"
        "local ammo = CONFIG.AMMO\n"
        "local reloading = false\n"
        "local lastShot = 0\n\n"
        "local function reload()\n"
        "    if reloading or ammo==CONFIG.AMMO then return end\n"
        "    reloading = true\n"
        "    print('Reloading...')\n"
        "    task.wait(CONFIG.RELOAD_TIME)\n"
        "    ammo = CONFIG.AMMO\n"
        "    reloading = false\n"
        "    print('Reloaded! '..ammo..'/'..CONFIG.AMMO)\n"
        "end\n\n"
        "local function shoot()\n"
        "    if reloading then return end\n"
        "    if ammo <= 0 then reload() return end\n"
        "    local now = tick()\n"
        "    if now-lastShot < CONFIG.FIRE_RATE then return end\n"
        "    lastShot = now\n"
        "    ammo -= 1\n"
        "    local unitRay = camera:ScreenPointToRay(mouse.X, mouse.Y)\n"
        "    ShootRemote:FireServer(unitRay.Origin, unitRay.Direction)\n"
        "end\n\n"
        "UserInputService.InputBegan:Connect(function(input, gpe)\n"
