def gen_tycoon():
    code = (
        "local Players = game:GetService('Players')\n\n"
        "local DROPPER_INTERVAL = 1\n"
        "local DROPPER_VALUE    = 10\n"
        "local tycoonOwners = {}\n\n"
        "local function claimTycoon(player, tycoon)\n"
        "    if tycoonOwners[tycoon] then return end\n"
        "    tycoonOwners[tycoon] = player\n"
        "    local pad = tycoon:FindFirstChild('ClaimPad')\n"
        "    if pad then pad.BrickColor = BrickColor.new('Bright green') end\n"
        "end\n\n"
        "local function startDropper(tycoon)\n"
        "    local dropper = tycoon:FindFirstChild('Dropper')\n"
        "    if not dropper then return end\n"
        "    task.spawn(function()\n"
        "        while tycoon.Parent do\n"
        "            task.wait(DROPPER_INTERVAL)\n"
        "            local player = tycoonOwners[tycoon]\n"
        "            if not player then continue end\n"
        "            local drop = Instance.new('Part')\n"
        "            drop.Name = 'Drop'\n"
        "            drop.Size = Vector3.new(0.5,0.5,0.5)\n"
        "            drop.BrickColor = BrickColor.new('Bright yellow')\n"
        "            drop.CFrame = dropper.CFrame * CFrame.new(0,-1,0)\n"
        "            drop.Parent = workspace\n"
        "            game:GetService('Debris'):AddItem(drop, 8)\n"
        "        end\n"
        "    end)\n"
        "end\n\n"
        "local function setupCollector(tycoon)\n"
        "    local collector = tycoon:FindFirstChild('Collector')\n"
        "    if not collector then return end\n"
        "    local debounce = {}\n"
        "    collector.Touched:Connect(function(hit)\n"
        "        if hit.Name~='Drop' or debounce[hit] then return end\n"
        "        debounce[hit] = true\n"
        "        local player = tycoonOwners[tycoon]\n"
        "        if player then\n"
        "            local coins = player.leaderstats and player.leaderstats:FindFirstChild('Coins')\n"
        "            if coins then coins.Value += DROPPER_VALUE end\n"
        "        end\n"
        "        hit:Destroy()\n"
        "    end)\n"
