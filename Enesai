# ══════════════════════════════════════════════════════════
# SCRIPT PLACEMENT DETECTOR
# ══════════════════════════════════════════════════════════
def detect_placement(code):
    c = code.lower()
    score = {"server": 0, "local": 0, "module": 0}

    server_kw = ["playeradded","playerremoving","datastoreservice","bindtoclose",
                 "fireclient","fireallclients","serverstorage","serverscriptservice",
                 "messagingservice","httpservice","onserverevent","memorystore"]
    local_kw  = ["localplayer","playergui","playerscripts","replicatedfirst",
                 "onclientevent","userinputservice","contextactionservice",
                 "renderstepped","fireserver","camera","inputbegan","tweenservice",
                 "screengui","startergui","starterplayerscripts"]
    module_kw = ["return ","setmetatable","__index","local module = {}",
                 "module.__index","function module.","function module:","module.new"]

    for kw in server_kw:
        if kw in c: score["server"] += 2
    for kw in local_kw:
        if kw in c: score["local"] += 2
    for kw in module_kw:
        if kw in c: score["module"] += 2
    if re.search(r'return\s+\w+\s*$', code.strip()): score["module"] += 6
    if re.search(r'local\s+\w+\s*=\s*\{\}', c) and re.search(r'return\s+\w+', c): score["module"] += 4

    best = max(score, key=score.get)

    info = {
        "server": {
            "type": "Script",
            "location": "ServerScriptService",
            "why": "Uses server-only services (DataStore, Players, etc). Runs on server only.",
            "how": "Explorer → ServerScriptService → right-click → Insert Object → Script"
        },
        "local": {
            "type": "LocalScript",
            "location": "StarterPlayer → StarterPlayerScripts  OR  StarterGui",
            "why": "Uses client-only APIs (LocalPlayer, GUI, UserInputService, Camera).",
            "how": "Explorer → StarterPlayer → StarterPlayerScripts → right-click → LocalScript"
        },
        "module": {
            "type": "ModuleScript",
            "location": "ReplicatedStorage (shared)  OR  ServerScriptService (server-only)",
            "why": "Shared logic required by other scripts via require().",
            "how": "Explorer → ReplicatedStorage → right-click → Insert Object → ModuleScript"
        }
    }
    return info[best]

