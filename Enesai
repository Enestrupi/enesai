# STUDIO PASTE FORMATTER

# ══════════════════════════════════════════════════════════

def studio_paste_block(scripts):
divider = “– “ + “═” * 60
parts = []
toc_lines = [”– 📋 SCRIPTS IN THIS PASTE:”]
for i, s in enumerate(scripts, 1):
toc_lines.append(f”–   {i}. {s[‘name’]} ({s[‘type’]}) → {s[‘location’]}”)
toc_lines.append(”– “ + “═” * 60)
parts.append(”\n”.join(toc_lines))
for s in scripts:
header = (
f”{divider}\n”
f”– [{s[‘type’].upper()}]  {s[‘name’]}\n”
f”– 📁 Location : {s[‘location’]}\n”
f”– 📌 How      : {s[‘how’]}\n”
f”{divider}\n”
)
parts.append(header + s[“code”])
return “`lua\n" + "\n\n\n".join(parts) + "\n`”

