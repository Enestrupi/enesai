        "            local coins = player.leaderstats and player.leaderstats:FindFirstChild('Coins')\n"
        "            if not coins or coins.Value < cost then return end\n"
        "            coins.Value -= cost\n"
        "            purchased = true\n"
        "            btn.BrickColor = BrickColor.new('Bright green')\n"
