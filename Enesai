    code = (
        "local Players = game:GetService('Players')\n"
        "local CONFIG={MAX_DELTA=50,RATE_LIMIT=10,LOG=true}\n"
        "local fireCounts,lastPositions={},{}\n\n"
        "local function checkRate(player)\n"
        "    local id=player.UserId\n"
        "    fireCounts[id]=fireCounts[id] or {count=0,t=tick()}\n"
        "    local d=fireCounts[id]\n"
        "    if tick()-d.t>1 then d.count=0;d.t=tick() end\n"
        "    d.count+=1\n"
        "    return d.count<=CONFIG.RATE_LIMIT\n"
        "end\n\n"
        "local function checkPos(player)\n"
        "    local hrp=player.Character and player.Character:FindFirstChild('HumanoidRootPart')\n"
        "    if not hrp then return true end\n"
        "    local pos=hrp.Position\n"
        "    local last=lastPositions[player.UserId]\n"
        "    lastPositions[player.UserId]=pos\n"
        "    if last and (pos-last).Magnitude>CONFIG.MAX_DELTA then return false end\n"
        "    return true\n"
        "end\n\n"
        "local AntiExploit={}\n"
        "function AntiExploit.validate(player)\n"
