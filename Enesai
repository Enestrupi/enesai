def gen_level_xp():
code = (
“local Players = game:GetService(‘Players’)\n\n”
“– XP required per level (level = index)\n”
“local LEVEL_TABLE = {}\n”
“for i = 1, 100 do\n”
“    LEVEL_TABLE[i] = math.floor(100 * (i ^ 1.5))  – curve: 100, 282, 519…\n”
“end\n\n”
“local function getXPForLevel(level)\n”
“    return LEVEL_TABLE[level] or math.huge\n”
“end\n\n”
“local LevelSystem = {}\n\n”
“function LevelSystem.addXP(player, amount)\n”
“    local stats = player:FindFirstChild(‘leaderstats’)\n”
“    if not stats then return end\n”
“    local xp    = stats:FindFirstChild(‘XP’)\n”
“    local level = stats:FindFirstChild(‘Level’)\n”
“    if not xp or not level then return end\n”
“    xp.Value += amount\n”
“    – Level up loop\n”
“    while xp.Value >= getXPForLevel(level.Value) do\n”
“        xp.Value -= getXPForLevel(level.Value)\n”
“        level.Value += 1\n”
“        print(player.Name,‘leveled up to level’,level.Value,’!’)\n”
“        – Reward on level up\n”
“        local coins = stats:FindFirstChild(‘Coins’)\n”
“        if coins then coins.Value += level.Value * 50 end\n”
“    end\n”
“end\n\n”
“function LevelSystem.getXPRequired(player)\n”
“    local stats = player:FindFirstChild(‘leaderstats’)\n”
“    local level = stats and stats:FindFirstChild(‘Level’)\n”
“    return level and getXPForLevel(level.Value) or 0\n”
“end\n\n”
“function LevelSystem.getProgress(player)\n”
“    local stats = player:FindFirstChild(‘leaderstats’)\n”
“    if not stats then return 0, 0 end\n”
“    local xp    = stats:FindFirstChild(‘XP’)\n”
“    local level = stats:FindFirstChild(‘Level’)\n”
“    if not xp or not level then return 0, 0 end\n”
“    return xp.Value, getXPForLevel(level.Value)\n”
“end\n\n”
“return LevelSystem”
)
return {“title”:“Level/XP System”,“name”:“LevelManager”,“type”:“ModuleScript”,
“location”:“ServerScriptService”,
“how”:“Explorer → ServerScriptService → Insert Object → ModuleScript”,“code”:code}

def gen_buff():
code = (
“local Players = game:GetService(‘Players’)\n\n”
“local BUFFS = {\n”
“    SpeedBoost  = { stat=‘WalkSpeed’, amount=10,  duration=30  },\n”
“    JumpBoost   = { stat=‘JumpPower’, amount=20,  duration=30  },\n”
“    Regeneration= { heal=5,           interval=1, duration=30  },\n”
“    DoubleDmg   = { dmgMult=2,        duration=20              },\n”
“    Invincible  = { invincible=true,  duration=5               },\n”
“}\n\n”
“local activeBuffs = {}  – [userId][buffName] = {expires, connections}\n\n”
“local BuffSystem = {}\n\n”
“function BuffSystem.apply(player, buffName)\n”
“    local buff = BUFFS[buffName]\n”
“    if not buff then return end\n”
“    local uid = player.UserId\n”
“    activeBuffs[uid] = activeBuffs[uid] or {}\n”
“    – Remove existing buff of same type\n”
“    BuffSystem.remove(player, buffName)\n”
“    local expires = tick() + buff.duration\n”
“    activeBuffs[uid][buffName] = { expires=expires }\n”
“    local char = player.Character\n”
“    local hum = char and char:FindFirstChild(‘Humanoid’)\n”
“    if hum and buff.stat then\n”
“        hum[buff.stat] = hum[buff.stat] + buff.amount\n”
“    end\n”
“    if buff.heal then\n”
“        task.spawn(function()\n”
“            while activeBuffs[uid] and activeBuffs[uid][buffName] and tick() < expires do\n”
“                local h = player.Character and player.Character:FindFirstChild(‘Humanoid’)\n”
“                if h then h.Health = math.min(h.MaxHealth, h.Health + buff.heal) end\n”
“                task.wait(buff.interval)\n”
“            end\n”
“        end)\n”
“    end\n”
“    – Auto remove on expire\n”
“    task.delay(buff.duration, function()\n”
“        BuffSystem.remove(player, buffName)\n”
“    end)\n”
“end\n\n”
“function BuffSystem.remove(player, buffName)\n”
“    local uid = player.UserId\n”
“    if not activeBuffs[uid] or not activeBuffs[uid][buffName] then return end\n”
“    local buff = BUFFS[buffName]\n”
“    activeBuffs[uid][buffName] = nil\n”
“    local hum = player.Character and player.Character:FindFirstChild(‘Humanoid’)\n”
“    if hum and buff and buff.stat then\n”
“        hum[buff.stat] = hum[buff.stat] - buff.amount\n”
“    end\n”
“end\n\n”
“function BuffSystem.has(player, buffName)\n”
“    local uid = player.UserId\n”
“    return activeBuffs[uid] and activeBuffs[uid][buffName] ~= nil\n”
“end\n\n”
“Players.PlayerRemoving:Connect(function(player)\n”
“    activeBuffs[player.UserId] = nil\n”
“end)\n\n”
“return BuffSystem”
)
return {“title”:“Buff System”,“name”:“BuffManager”,“type”:“ModuleScript”,
“location”:“ServerScriptService”,
“how”:“Explorer → ServerScriptService → Insert Object → ModuleScript”,“code”:code}

def gen_party():
code = (
“local Players = game:GetService(‘Players’)\n”
“local ReplicatedStorage = game:GetService(‘ReplicatedStorage’)\n\n”
“local PartyRemote = ReplicatedStorage:WaitForChild(‘Remotes’):WaitForChild(‘Party’)\n\n”
“local parties = {}   – {leaderId: {members=[playerIds], maxSize=4}}\n”
“local playerParty = {} – {playerId: leaderId}\n\n”
“local MAX_PARTY = 4\n\n”
“local PartySystem = {}\n\n”
“function PartySystem.create(leader)\n”
“    if playerParty[leader.UserId] then return false, ‘Already in a party’ end\n”
“    parties[leader.UserId] = { leader=leader, members={[leader.UserId]=leader}, size=1 }\n”
“    playerParty[leader.UserId] = leader.UserId\n”
“    return true\n”
“end\n\n”
“function PartySystem.invite(leader, target)\n”
“    local party = parties[leader.UserId]\n”
“    if not party or party.leader ~= leader then return false, ‘Not party leader’ end\n”
“    if party.size >= MAX_PARTY then return false, ‘Party full’ end\n”
“    if playerParty[target.UserId] then return false, ‘Player already in a party’ end\n”
“    PartyRemote:FireClient(target, ‘invite’, leader.Name)\n”
“    return true\n”
“end\n\n”
“function PartySystem.join(player, leaderId)\n”
“    local party = parties[leaderId]\n”
“    if not party then return false, ‘Party not found’ end\n”
“    if party.size >= MAX_PARTY then return false, ‘Party full’ end\n”
“    party.members[player.UserId] = player\n”
“    party.size += 1\n”
“    playerParty[player.UserId] = leaderId\n”
“    – Notify all members\n”
“    for _, member in pairs(party.members) do\n”
“        PartyRemote:FireClient(member, ‘joined’, player.Name)\n”
“    end\n”
“    return true\n”
“end\n\n”
“function PartySystem.leave(player)\n”
“    local leaderId = playerParty[player.UserId]\n”
“    if not leaderId then return end\n”
“    local party = parties[leaderId]\n”
“    if not party then return end\n”
“    party.members[player.UserId] = nil\n”
“    party.size -= 1\n”
“    playerParty[player.UserId] = nil\n”
“    – If leader left, disband\n”
“    if player.UserId == leaderId then\n”
“        for _, member in pairs(party.members) do\n”
“            playerParty[member.UserId] = nil\n”
“            PartyRemote:FireClient(member, ‘disbanded’, ‘Leader left’)\n”
“        end\n”
“        parties[leaderId] = nil\n”
“    end\n”
“end\n\n”
“function PartySystem.getParty(player)\n”
“    local leaderId = playerParty[player.UserId]\n”
“    return leaderId and parties[leaderId] or nil\n”
“end\n\n”
“function PartySystem.areInSameParty(p1, p2)\n”
“    local l1 = playerParty[p1.UserId]\n”
“    local l2 = playerParty[p2.UserId]\n”
“    return l1 ~= nil and l1 == l2\n”
“end\n\n”
“Players.PlayerRemoving:Connect(function(p) PartySystem.leave(p) end)\n”
“return PartySystem”
)
return {“title”:“Party System”,“name”:“PartyManager”,“type”:“ModuleScript”,
“location”:“ServerScriptService”,
“how”:“Explorer → ServerScriptService → Insert Object → ModuleScript”,“code”:code}

def gen_placement_system():
code = (
“– Object Placement System (like Build-a-Boat, Bloxburg)\n”
“local Players = game:GetService(‘Players’)\n”
“local UserInputService = game:GetService(‘UserInputService’)\n”
“local RunService = game:GetService(‘RunService’)\n\n”
“local player = Players.LocalPlayer\n”
“local mouse = player:GetMouse()\n”
“local camera = workspace.CurrentCamera\n\n”
“local GRID_SIZE = 4\n”
“local placing = false\n”
“local previewModel = nil\n\n”
“local function snapToGrid(v)\n”
“    return Vector3.new(\n”
“        math.round(v.X / GRID_SIZE) * GRID_SIZE,\n”
“        v.Y,\n”
“        math.round(v.Z / GRID_SIZE) * GRID_SIZE\n”
“    )\n”
“end\n\n”
“local function startPlacing(modelName)\n”
“    local template = game:GetService(‘ReplicatedStorage’):FindFirstChild(modelName)\n”
“    if not template then return end\n”
“    if previewModel then previewModel:Destroy() end\n”
“    previewModel = template:Clone()\n”
“    – Make it semi-transparent\n”
“    for _, part in ipairs(previewModel:GetDescendants()) do\n”
“        if part:IsA(‘BasePart’) then\n”
“            part.Transparency = 0.5\n”
“            part.CanCollide = false\n”
“        end\n”
“    end\n”
“    previewModel.Parent = workspace\n”
“    placing = true\n”
“end\n\n”
“local function stopPlacing(confirm)\n”
“    placing = false\n”
“    if previewModel then\n”
“        if confirm then\n”
“            – Tell server to place object\n”
“            local pos = previewModel:GetPrimaryPartCFrame().Position\n”
“            – PlaceRemote:FireServer(previewModel.Name, pos)\n”
“        end\n”
“        previewModel:Destroy()\n”
“        previewModel = nil\n”
“    end\n”
“end\n\n”
“RunService.RenderStepped:Connect(function()\n”
“    if not placing or not previewModel then return end\n”
“    local ray = camera:ScreenPointToRay(mouse.X, mouse.Y)\n”
“    local result = workspace:Raycast(ray.Origin, ray.Direction * 200)\n”
“    if result then\n”
“        local snapped = snapToGrid(result.Position)\n”
“        previewModel:SetPrimaryPartCFrame(CFrame.new(snapped))\n”
“    end\n”
“end)\n\n”
“UserInputService.InputBegan:Connect(function(input, gpe)\n”
“    if gpe then return end\n”
“    if input.UserInputType == Enum.UserInputType.MouseButton1 then\n”
“        if placing then stopPlacing(true) end\n”
“    elseif input.KeyCode == Enum.KeyCode.X then\n”
“        if placing then stopPlacing(false) end\n”
“    elseif input.KeyCode == Enum.KeyCode.R then\n”
“        – Rotate\n”
“        if placing and previewModel then\n”
“            previewModel:SetPrimaryPartCFrame(\n”
“                previewModel:GetPrimaryPartCFrame() * CFrame.Angles(0, math.rad(90), 0)\n”
“            )\n”
“        end\n”
“    end\n”
“end)\n\n”
“– Example: start placing a ‘Wall’ on key press\n”
“UserInputService.InputBegan:Connect(function(input, gpe)\n”
“    if gpe then return end\n”
“    if input.KeyCode == Enum.KeyCode.One then startPlacing(‘Wall’) end\n”
“    if input.KeyCode == Enum.KeyCode.Two then startPlacing(‘Floor’) end\n”
“    if input.KeyCode == Enum.KeyCode.Three then startPlacing(‘Roof’) end\n”
“end)”
)
return {“title”:“Placement System”,“name”:“PlacementClient”,“type”:“LocalScript”,
“location”:“StarterPlayer → StarterPlayerScripts”,
“how”:“Explorer → StarterPlayer → StarterPlayerScripts → Insert Object → LocalScript”,“code”:code}

