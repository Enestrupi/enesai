“– OOP Class Template\n”
“local MyClass = {}\n”
“MyClass.__index = MyClass\n\n”
“function MyClass.new(name, value)\n”
“    local self = setmetatable({}, MyClass)\n”
“    self.Name = name\n”
“    self.Value = value\n”
“    self._connections = {}\n”
“    return self\n”
“end\n\n”
“function MyClass:getValue() return self.Value end\n”
“function MyClass:setValue(v) self.Value = v end\n”
“function MyClass:getName()  return self.Name  end\n\n”
“function MyClass:connect(signal, fn)\n”
“    local conn = signal:Connect(fn)\n”
“    table.insert(self._connections, conn)\n”
“    return conn\n”
“end\n\n”
“function MyClass:destroy()\n”
“    for _, conn in ipairs(self._connections) do conn:Disconnect() end\n”
“    setmetatable(self, nil)\n”
“end\n\n”
“return MyClass”
)
