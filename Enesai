def gen_npc():
    code = (
        "local PathfindingService = game:GetService('PathfindingService')\n"
        "local Players = game:GetService('Players')\n\n"
        "local npc = script.Parent\n"
        "local humanoid = npc:WaitForChild('Humanoid')\n"
        "local hrp = npc:WaitForChild('HumanoidRootPart')\n\n"
        "local CONFIG = { AGGRO_RANGE=30, ATTACK_RANGE=4, DAMAGE=15, COOLDOWN=1.5 }\n\n"
        "local function moveTo(target)\n"
        "    local path = PathfindingService:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true})\n"
        "    local ok = pcall(path.ComputeAsync, path, hrp.Position, target)\n"
        "    if not ok or path.Status==Enum.PathStatus.NoPath then return end\n"
        "    for _, wp in ipairs(path:GetWaypoints()) do\n"
        "        if wp.Action==Enum.PathWaypointAction.Jump then humanoid.Jump=true end\n"
        "        humanoid:MoveTo(wp.Position)\n"
        "        if not humanoid.MoveToFinished:Wait(3) then break end\n"
        "    end\n"
        "end\n\n"
        "local function getNearestPlayer()\n"
        "    local nearest, dist = nil, CONFIG.AGGRO_RANGE\n"
        "    for _, p in ipairs(Players:GetPlayers()) do\n"
        "        if p.Character and p.Character:FindFirstChild('HumanoidRootPart') then\n"
        "            local d = (p.Character.HumanoidRootPart.Position-hrp.Position).Magnitude\n"
        "            if d<dist then nearest,dist=p,d end\n"
        "        end\n"
        "    end\n"
        "    return nearest\n"
        "end\n\n"
        "local lastAttack = 0\n"
        "while humanoid.Health > 0 do\n"
        "    local target = getNearestPlayer()\n"
        "    if target then\n"
        "        local d = (target.Character.HumanoidRootPart.Position-hrp.Position).Magnitude\n"
        "        if d<=CONFIG.ATTACK_RANGE then\n"
        "            if tick()-lastAttack>=CONFIG.COOLDOWN then\n"
        "                lastAttack=tick()\n"
        "                local h = target.Character:FindFirstChild('Humanoid')\n"
        "                if h then h:TakeDamage(CONFIG.DAMAGE) end\n"
        "            end\n"
        "        else moveTo(target.Character.HumanoidRootPart.Position) end\n"
        "    end\n"
        "    task.wait(0.1)\n"
        "end\n"
        "npc:Destroy()"
    )
    return {"title":"NPC AI","name":"NPCController","type":"Script",
            "location":"Inside NPC Model",
            "how":"Explorer → NPC Model → Insert Object → Script","code":code}

